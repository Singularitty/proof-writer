{
  "name": "proof-writer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsx src/check/cli.ts",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "immer": "^10.1.1",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "zustand": "^4.5.5"
  },
  "description": "Write type systems, proof trees and soundness proofs; export to Typst and LaTeX.",
  "author": "Singularitty",
  "license": "MIT",
  "homepage": "https://singularitty.github.io/proof-writer/",
  "repository": "github:Singularitty/proof-writer",
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.singularitty.proofwriter",
    "productName": "Proof Writer",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "json",
        "name": "Proof Writer document",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
